# =============================================================================
# Barbattia Web - variables de entorno (copia este archivo como .env.local)
# Todas son OPCIONALES. Si una URL de tienda no esta definida, el boton se
# muestra como "Proximamente" (deshabilitado), nunca como un enlace falso.
# =============================================================================

# Dominio publico del sitio, sin "/" final. Se usa para canonical, Open Graph,
# sitemap.xml, robots.txt y como destino por defecto del QR.
VITE_SITE_URL=

# Enlaces de las tiendas (dejar vacio = "Proximamente")
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# Destino del codigo QR. Por defecto: <VITE_SITE_URL>/#/descargar
# (pagina que detecta iOS/Android y muestra la tienda correcta).
VITE_DOWNLOAD_PAGE_URL=

# Contacto
VITE_CONTACT_EMAIL=
# Numero de WhatsApp en formato internacional, solo digitos (ej. 573001234567)
VITE_WHATSAPP=
# Si se define, el formulario de contacto hace POST JSON a esta URL en lugar
# de abrir el cliente de correo (mailto:).
VITE_CONTACT_ENDPOINT=

# Redes sociales (vacio = no se muestran)
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=

# API de Barbattia (backend/). Si se define, la tienda intenta cargar
# GET <VITE_API_URL>/api/products y usa los datos locales como respaldo.
VITE_API_URL=
